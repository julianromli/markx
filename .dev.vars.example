# Local development secrets — copy to .dev.vars (gitignored).
# In dev the Cloudflare Vite plugin reads these via the `cloudflare:workers`
# `env` object.

# Postgres connection string (local Postgres or the rehearsal DB).
# `bun run dev` maps this to CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE
# (Wrangler requires that process env var to emulate the Hyperdrive binding locally).
# Never point local dev at the production database.
# A fresh DB needs the app migrations (bun run db:migrate) and
# scripts/sql/auth-schema.sql (psql "$DATABASE_URL" -f scripts/sql/auth-schema.sql).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/markx_dev"

# Optional override for Hyperdrive local emulation. If unset, `bun run dev` uses
# DATABASE_URL above. Must be exported in the process env (not only as a Worker
# secret) — the launch script handles that for you.
# CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE="<same as DATABASE_URL>"

# Better Auth. Secret signs session cookies (32+ chars).
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="dev-only-secret-replace-in-production-32chars"
# Overrides the wrangler.jsonc var for local dev.
BETTER_AUTH_URL="http://localhost:3000"
# OTP mail uses the EMAIL send_email binding. `bun run dev` simulates it
# locally and prints where the message was saved.

# Mayar billing (Markx Pro, custom QRIS checkout). Use sandbox key locally.
# Feature flag (also in wrangler.jsonc vars). "true" enables limits + checkout UI.
# MAYAR_BILLING_ENABLED=false
MAYAR_API_KEY=
MAYAR_ENV=sandbox
# Pro price in IDR per 30-day period. Optional — defaults to 49000.
# MAYAR_PRO_PRICE_IDR=49000
