# Browser-exposed env vars (prefixed with VITE_).
# The auth client's base URL. Better Auth requires an ABSOLUTE URL, so:
#  - Leave UNSET in production: defaults to `${origin}/api/auth`, i.e. the
#    same-origin Better Auth handler (src/server.ts), first-party cookies.
#  - A relative path (e.g. `/api/auth`) is resolved against the page origin.
#  - An absolute URL (e.g. `http://localhost:3000/api/auth`) is used as-is
#    (this is the local-dev case — see .env).
VITE_AUTH_URL="/api/auth"

# Mayar + other server secrets live in .dev.vars (see .dev.vars.example).
# Production: wrangler secret put MAYAR_API_KEY (etc).
