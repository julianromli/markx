{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "markx",
  "main": "src/server.ts",
  "compatibility_date": "2026-07-24",
  "compatibility_flags": ["nodejs_compat", "disable_nodejs_console_module"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    // Better Auth public URL. Secret BETTER_AUTH_SECRET: wrangler secret put.
    "BETTER_AUTH_URL": "https://markx.app",
    // Pro limits + Mayar checkout UI. Set "true" to enable (dashboard vars or deploy).
    "MAYAR_BILLING_ENABLED": "true"
  },
  "r2_buckets": [
    {
      "binding": "MARKX_BUCKET",
      "bucket_name": "markx"
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // TODO(cutover): replace with the `markx-vps` Hyperdrive id
      // (db `markx` on the VPS). Still the Neon config until then.
      "id": "e350ce8b19b44756ad877e79b4c0675f"
    }
  ],
  // Cloudflare Email Service: sign-in OTP mail.
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["welcome@markx.faizintifada.com"]
    }
  ],
  "triggers": {
    "crons": ["0 3 * * *"]
  }
}
