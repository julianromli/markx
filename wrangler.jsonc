{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "markx",
  "main": "src/server.ts",
  "compatibility_date": "2026-07-24",
  "compatibility_flags": ["nodejs_compat", "disable_nodejs_console_module"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "NEON_AUTH_BASE_URL": "https://ep-lingering-dust-azywq1po.neonauth.c-3.ap-southeast-1.aws.neon.tech/neondb/auth",
    "NEON_AUTH_JWKS_URL": "https://ep-lingering-dust-azywq1po.neonauth.c-3.ap-southeast-1.aws.neon.tech/neondb/auth/.well-known/jwks.json",
    // Flip to "true" (dashboard vars or deploy) to enable Pro limits + Mayar checkout UI.
    "MAYAR_BILLING_ENABLED": "false"
  },
  "r2_buckets": [
    {
      "binding": "MARKX_BUCKET",
      "bucket_name": "markx"
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "e350ce8b19b44756ad877e79b4c0675f"
    }
  ],
  "triggers": {
    "crons": ["0 3 * * *"]
  }
}
